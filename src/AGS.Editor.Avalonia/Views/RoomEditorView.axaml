<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AGS.Editor.Avalonia.ViewModels"
             x:Class="AGS.Editor.Avalonia.Views.RoomEditorView"
             x:DataType="vm:RoomEditorDocument">
  <DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox ItemsSource="{Binding ZoomLevels}" SelectedItem="{Binding Zoom}" MinWidth="64" Margin="0,0,12,0" />
      <TextBlock Text="Background" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox ItemsSource="{Binding BackgroundFrames}" SelectedItem="{Binding BackgroundFrame}" MinWidth="56" Margin="0,0,4,0" />
      <Button Content="Import…" ToolTip.Tip="Replace this background with an image file" Margin="0,0,4,0"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)Tag).ImportBackgroundCommand}"
              CommandParameter="{Binding}" />
      <Button Content="Add…" ToolTip.Tip="Add an animation frame from an image file" Margin="0,0,4,0"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)Tag).AddBackgroundCommand}"
              CommandParameter="{Binding}" />
      <Button Content="Delete" IsEnabled="{Binding CanDeleteBackground}" Margin="0,0,12,0"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)Tag).DeleteBackgroundCommand}"
              CommandParameter="{Binding}" />
      <CheckBox Content="Objects" IsChecked="{Binding ShowObjects}" Margin="0,0,8,0" />
      <CheckBox Content="Characters" IsChecked="{Binding ShowCharacters}" Margin="0,0,8,0" />
      <CheckBox Content="Edges" IsChecked="{Binding ShowEdges}" Margin="0,0,8,0" />
      <CheckBox Content="Walkable areas" IsChecked="{Binding ShowWalkableAreas}" Margin="0,0,8,0" />
      <CheckBox Content="Hotspots" IsChecked="{Binding ShowHotspots}" Margin="0,0,8,0" />
      <CheckBox Content="Regions" IsChecked="{Binding ShowRegions}" Margin="0,0,8,0" />
      <CheckBox Content="Walk-behinds" IsChecked="{Binding ShowWalkBehinds}" />
    </WrapPanel>
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox ItemsSource="{Binding EditModes}" SelectedItem="{Binding EditMode}" MinWidth="90" Margin="0,0,12,0" />
      <StackPanel Orientation="Horizontal" IsVisible="{Binding IsPainting}">
        <TextBlock Text="Layer" VerticalAlignment="Center" Margin="0,0,4,0" />
        <ComboBox ItemsSource="{Binding PaintLayers}" SelectedItem="{Binding PaintLayer}" MinWidth="130" Margin="0,0,12,0" />
        <TextBlock Text="Area" VerticalAlignment="Center" Margin="0,0,4,0" />
        <NumericUpDown Value="{Binding AreaNumber}" Minimum="0" Maximum="{Binding MaxAreaNumber}" FormatString="0" Increment="1"
                       MinWidth="110" Margin="0,0,12,0" />
        <TextBlock Text="Tool" VerticalAlignment="Center" Margin="0,0,4,0" />
        <ComboBox ItemsSource="{Binding MaskTools}" SelectedItem="{Binding Tool}" MinWidth="110" Margin="0,0,12,0" />
        <Button Content="Undo" Click="OnUndo" IsEnabled="{Binding CanUndo}" Margin="0,0,12,0" />
        <Button Content="Import mask…" ToolTip.Tip="Import mask from file (an indexed image of the mask's size)" Margin="0,0,4,0"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)Tag).ImportMaskCommand}"
                CommandParameter="{Binding}" />
        <Button Content="Export mask…" ToolTip.Tip="Export mask to file"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)Tag).ExportMaskCommand}"
                CommandParameter="{Binding}" />
      </StackPanel>
    </WrapPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
      <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" />
      <TextBlock x:Name="Coordinates" Opacity="0.7" />
      <TextBlock Text="{Binding Info}" Opacity="0.6" />
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#30808080">
      <Image x:Name="RoomImage" Source="{Binding Image}" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
             Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"
             HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Cross" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
