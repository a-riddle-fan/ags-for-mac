<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AGS.Editor.Avalonia.ViewModels"
             x:Class="AGS.Editor.Avalonia.Views.PropertyGridView"
             x:DataType="vm:PropertyGridViewModel">
  <!-- The property grid (rows of PropertyGridViewModel); used by the main window and by dialogs. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.DataTemplates>
        <DataTemplate DataType="vm:CategoryRow">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,10,6,4" Opacity="0.85" />
        </DataTemplate>
        <DataTemplate DataType="vm:TextPropertyRow">
          <Grid ColumnDefinitions="130,*,Auto" Margin="10,1,6,1" ToolTip.Tip="{Binding Description}">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.75" />
            <TextBox Grid.Column="1" Text="{Binding Text}" IsReadOnly="{Binding !CanEditText}" Opacity="{Binding TextOpacity}"
                     MinHeight="24" Padding="4,2" FontSize="12" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="…" Padding="6,0" Margin="4,0,0,0" IsVisible="{Binding HasEditorButton}"
                    Command="{Binding OpenEditorCommand}" />
          </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:BoolPropertyRow">
          <Grid ColumnDefinitions="130,*" Margin="10,1,6,1" ToolTip.Tip="{Binding Description}">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.75" />
            <CheckBox Grid.Column="1" IsChecked="{Binding Value}" IsEnabled="{Binding IsEditable}" Margin="6,0,0,0" MinHeight="24" />
          </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:ChoicePropertyRow">
          <Grid ColumnDefinitions="130,*,Auto" Margin="10,1,6,1" ToolTip.Tip="{Binding Description}">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.75" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" IsEnabled="{Binding IsEditable}"
                      HorizontalAlignment="Stretch" MinHeight="24" FontSize="12" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="…" Padding="6,0" Margin="4,0,0,0" IsVisible="{Binding HasEditorButton}"
                    Command="{Binding OpenEditorCommand}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.DataTemplates>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
