<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AGS.Editor.Avalonia.ViewModels"
             xmlns:views="using:AGS.Editor.Avalonia.Views"
             xmlns:types="using:AGS.Types"
             xmlns:core="using:AGS.Editor"
             x:Class="AGS.Editor.Avalonia.Views.FindInScriptsView"
             x:DataType="vm:FindInScriptsDocument">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Find" Width="70" VerticalAlignment="Center" />
        <TextBox Text="{Binding SearchText}" Width="320" KeyDown="OnFindKeyDown" />
        <Button Content="Find All" Click="OnFindAll" IsDefault="True" />
        <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" Margin="12,0,0,0" />
        <CheckBox Content="Whole word" IsChecked="{Binding WholeWord}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Replace" Width="70" VerticalAlignment="Center" />
        <TextBox Text="{Binding ReplaceText}" Width="320" />
        <Button Content="Replace All" Click="OnReplaceAll" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" Opacity="0.7" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" DoubleTapped="OnFindResultDoubleTapped"
             FontFamily="Menlo, Monaco, monospace" FontSize="12">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:ScriptSearchResult">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Line, StringFormat='({0})'}" Opacity="0.7" />
            <TextBlock Text="{Binding LineText}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
