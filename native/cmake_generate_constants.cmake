# ags4mac: generates the native-constants table from upstream's NativeMethods::GetNativeConstant()
# (ags/Editor/AGS.Native/NativeMethods.cpp), so names and values always follow upstream.
# Usage: include() with AGS_ROOT and AGSN_CONSTANTS_OUT set.

set(_src "${AGS_ROOT}/Editor/AGS.Native/NativeMethods.cpp")
# Read as one string and split lines ourselves: CMake lists use ';' as separator, so semicolons
# in the C++ code are replaced by a placeholder first (none of the parsed lines contain brackets).
file(READ "${_src}" _text)
string(REPLACE "\r" "" _text "${_text}")
string(REPLACE ";" "@SEMI@" _text "${_text}")
# Unbalanced square brackets also stop CMake from splitting a list; neutralize them.
string(REPLACE "[" "@LB@" _text "${_text}")
string(REPLACE "]" "@RB@" _text "${_text}")
string(REPLACE "\n" ";" _lines "${_text}")
set(_in_function FALSE)
set(_entries "")
set(_count 0)
# Constants that aren't plain integers are provided by agsn_constants.cpp itself.
set(_special GAME_FILE_SIG SPRSET_NAME PASSWORD_ENC_STRING)

foreach(_line IN LISTS _lines)
    if(_line MATCHES "NativeMethods::GetNativeConstant\\(")
        set(_in_function TRUE)
        continue()
    endif()
    if(NOT _in_function)
        continue()
    endif()
    if(_line MATCHES "^[ \t]*return nullptr@SEMI@")
        break()
    endif()
    if(_line MATCHES "name->Equals\\(\"([A-Za-z0-9_]+)\"\\)\\)[ \t]*return[ \t]+(.+)@SEMI@[ \t]*$")
        set(_name "${CMAKE_MATCH_1}")
        set(_expr "${CMAKE_MATCH_2}")
        list(FIND _special "${_name}" _is_special)
        if(NOT _is_special EQUAL -1)
            continue()
        endif()
        # Unwrap C++/CLI boxing: safe_cast<Object^>(X) -> X
        if(_expr MATCHES "^safe_cast<Object\\^>\\((.+)\\)$")
            set(_expr "${CMAKE_MATCH_1}")
        endif()
        if(_expr MATCHES "gcnew|\\^")
            message(FATAL_ERROR "GetNativeConstant: unsupported expression for ${_name}: ${_expr}; update native/cmake_generate_constants.cmake")
        endif()
        string(APPEND _entries "    { \"${_name}\", static_cast<int32_t>(${_expr}) },\n")
        math(EXPR _count "${_count} + 1")
    elseif(_line MATCHES "name->Equals\\(\"([A-Za-z0-9_]+)\"\\)")
        list(FIND _special "${CMAKE_MATCH_1}" _is_special)
        if(_is_special EQUAL -1)
            message(FATAL_ERROR "GetNativeConstant: unrecognized form for ${CMAKE_MATCH_1}; update native/cmake_generate_constants.cmake")
        endif()
    endif()
endforeach()

if(_count LESS 50)
    message(FATAL_ERROR "GetNativeConstant: found only ${_count} constants in ${_src}; parser out of date?")
endif()

set(_content "// Generated from ${_src} by native/cmake_generate_constants.cmake; do not edit.\n${_entries}")
if(EXISTS "${AGSN_CONSTANTS_OUT}")
    file(READ "${AGSN_CONSTANTS_OUT}" _old)
else()
    set(_old "")
endif()
if(NOT _old STREQUAL _content)
    file(WRITE "${AGSN_CONSTANTS_OUT}" "${_content}")
endif()
message(STATUS "ags4mac: generated ${_count} native integer constants")
