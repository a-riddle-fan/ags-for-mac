Tools: 32 to 16-bit, treat zero alpha and opaque magenta as mask

FixMaskColorImpl() compared 32-bit source pixels, which carry alpha (0xFFFF00FF
for opaque magenta), against MASK_COLOR_32 (0xFF00FF, "a value without alpha"),
so a magenta-keyed PNG imported into a 16-bit game lost its transparency
(0xF81F became 0xF83F), and zero-alpha pixels became visible.

As suggested in the upstream review (adventuregamestudio/ags#3144): a 32-bit
pixel becomes the mask color if it has zero alpha or is opaque magenta; a
semi-transparent magenta stays visible (near-magenta safe color). The upstream
PR also changes the Windows editor (AGS.Native CreateBlockFromBitmap) the same
way, so both behave identically; only the tool part is needed here.

Found by ags4mac (macOS editor port).

diff --git a/Tools/data/sprite_utils.cpp b/Tools/data/sprite_utils.cpp
index 4cc5736ee..bb397f3c0 100644
--- a/Tools/data/sprite_utils.cpp
+++ b/Tools/data/sprite_utils.cpp
@@ -359,7 +359,13 @@ static void FixMaskColorImpl(const uint8_t *src_buf, const uint8_t *src_end,
         {
             const SrcPxType src_color = *src_ptr;
             const DstPxType dst_color = *dst_ptr;
-            if (src_color == src_maskcolor)
+            // A 32-bit source pixel is transparent if it has zero alpha,
+            // or if it is an opaque mask color (src_maskcolor is passed opaque in this case);
+            // semi-transparent mask colors are kept as normal colors.
+            const bool is_mask = (sizeof(SrcPxType) == 4) ?
+                ((geta32(src_color) == 0) || (src_color == src_maskcolor)) :
+                (src_color == src_maskcolor);
+            if (is_mask)
                 *dst_ptr = dst_maskcolor;
             else if (dst_color == dst_maskcolor) // replace mask color with close match
                 *dst_ptr = safe_color;
@@ -394,7 +400,7 @@ static void ConvertAndFixMaskColor(const BitmapData &src, PixelBuffer &dst, cons
         {
             FixMaskColorImpl<uint32_t, uint16_t>(src.GetData(), src.GetData() + src.GetHeight() * src.GetStride(), dst.GetData(),
                 src.GetWidth(), src.GetStride(), dst.GetStride(),
-                GetDefaultMaskColor(src.GetFormat()), GetDefaultMaskColor(dst.GetFormat()), replacement_mask_color(dst.GetColorDepth(), GetDefaultMaskColor(dst.GetFormat())));
+                GetDefaultMaskColor(src.GetFormat()) | (0xFFu << _rgb_a_shift_32), GetDefaultMaskColor(dst.GetFormat()), replacement_mask_color(dst.GetColorDepth(), GetDefaultMaskColor(dst.GetFormat())));
         }
         else
         {
