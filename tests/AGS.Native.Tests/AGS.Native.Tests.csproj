  <ItemGroup>
    <ProjectReference Include="../../src/AGS.Native.Interop/AGS.Native.Interop.csproj" />
    <ProjectReference Include="../../src/AGS.Imaging.Magick/AGS.Imaging.Magick.csproj" />
    <ProjectReference Include="../../src/AGS.Types.Core/AGS.Types.Core.csproj" />
  </ItemGroup>

</Project>
